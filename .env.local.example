# Copy to .env.local (gitignored) and fill in as needed.
# No committed .env.example previously existed in this repo; these are the
# actual env vars read in src/, found by grep as of main@ed15892.

# Postgres connection. The app builds/serves fine without this — only the
# lead-capture paths (contact/intake/report) and the planned AI agent
# feature need it. Value below matches docker-compose.yml's defaults
# exactly (`docker compose up -d` then use this as-is).
DATABASE_URL=postgresql://oxot:oxot_dev_local_only@localhost:5433/oxot_website_dev

# Optional. Slack/Teams/Zapier-style webhook fired (best-effort,
# non-blocking) after a contact-form lead is recorded. Leave unset for a
# silent no-op — the DB row is written either way.
CONTACT_WEBHOOK_URL=

# Optional. Salt for hashing client IPs before storing with leads (never
# raw IPs). Defaults to a hardcoded dev salt if unset — fine for local dev,
# should be a real secret in any shared/deployed environment.
IP_HASH_SALT=

# Must be exactly "true" for the site to be indexable; otherwise noindex.
OXOT_PUBLIC_SITE=true
